{
  "name": "@tucbs/components",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/tucbs-components.es.js",
  "module": "./dist/tucbs-components.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/tucbs-components.es.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.lib.ts",
    "pretypecheck": "pnpm --dir ../.. run lint && pnpm --dir ../.. run check:imports && pnpm --dir ../.. run check:duplication && pnpm --dir ../.. run check:file-length",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schema:generate": "node scripts/generate-schema.mjs",
    "docs:generate": "typedoc",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tucbs/core": "^0.1.0",
    "cesium": "^1.142.0",
    "lit": "^3.2.1"
  },
  "dependencies": {
    "@carbon/icons": "^11.84.0",
    "@carbon/web-components": "^2.57.0",
    "proj4": "^2.20.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "cesium": "^1.142.0",
    "jsdom": "^30.1.1",
    "lit": "^3.2.1",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-bundle-obfuscator": "^1.13.1",
    "vite-plugin-cesium": "1.2.23",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.9"
  }
}
