checkbox label-text="Paleti ters çevir" id="checkbox"></cds-checkbox></div><div style="margin-top: 8px"><span class="field-label">Opaklık (60%)</span><input type="range" class="opacity-slider" min="0" max="100" step="1" style="--fill: 60%"></div></div><div class="card"><span class="card-title">Dış Hat</span><div><span class="field-label">Renk Paleti</span><span class="color-swatch" style="background:#1a73e8"><input type="color" aria-label="Dış hat rengi"></span></div><div><span class="field-label">Genişlik</span><cds-number-input size="sm" type="text" locale="en" label="Genişlik" hide-label="" min="0.5" max="50" step="0.5" pattern="[0-9]*" placeholder="" input-mode="decimal" value="2"></cds-number-input></div><div><cds-checkbox label-text="Etkin" checked="" id="checkbox"></cds-checkbox></div></div><div class="card"><span class="card-title">Değerler</span><div class="category-values-wrap"><div class="category-values-list"><div style="display:flex; flex-direction:column; gap:0.5rem;"><div class="legend-bin-row"><span class="legend-swatch" style="background:#ff0000"></span><span class="legend-value" title="konut">konut</span></div><div class="legend-bin-row"><span class="legend-swatch" style="background:#0000ff"></span><span class="legend-value" title="sanayi">sanayi</span></div><div class="legend-bin-row"><span class="legend-swatch" style="background:#00ff00"></span><span class="legend-value" title="ticari">ticari</span></div></div></div><div class="category-scroll-thumb"></div></div></div>",
}
`;

